# Copy to .env and fill in. Variables marked REQUIRED stop the server at startup when missing.

# --- App -------------------------------------------------------------------
# REQUIRED. Public URL of this instance; used for links in notifications.
BASE_URL=https://twinbox.example.com
# REQUIRED. Encrypts stored IMAP credentials. Keep it stable: changing it makes stored credentials unreadable.
SECRET_ENCRYPTION_KEY=
# REQUIRED. Encrypts session cookies, at least 32 characters.
NUXT_SESSION_PASSWORD=
# Set to false when serving over plain HTTP on a non-localhost address (otherwise logins fail).
# NUXT_SESSION_COOKIE_SECURE=true
# Initial admin. The first start creates ADMIN_USER (default: admin) without a password of its own: it signs in with
# ADMIN_PASSWORD (12 to 128 characters) until it sets its own password in the app; after that the variable can go.
# REQUIRED while an account has no password of its own: without it the server logs why and doesn't start.
# ADMIN_USER=admin
ADMIN_PASSWORD=
# Or read the password from a file, e.g. a Docker secret:
# ADMIN_PASSWORD_FILE=/run/secrets/twinbox_admin_password
# Allow public sign-up (true/1). Default: disabled, admins create accounts.
# REGISTRATION_ENABLE=false
# Server time zone (relative IMAP search dates, dates in LLM prompts, logs). Default: UTC
# TZ=Europe/Berlin

# --- LLM (OpenAI-compatible API) --------------------------------------------
# REQUIRED. Base URL without /v1, e.g. http://ollama:11434 or http://vllm:8000
LLM_BASE_URL=
# REQUIRED. Model name as the server lists it under /v1/models
LLM_MODEL=
# LLM_API_KEY=
# Optional JSON object merged into every request, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
# LLM_EXTRA_BODY=

# --- Text to speech (only needed for the TTS task) ---------------------------
# TTS_BASE_URL=
# TTS_API_KEY=

# --- Notifications (only needed for Apprise channels) -----------------------
# APPRISE_URL=http://apprise:8000

# --- Limits -----------------------------------------------------------------
# Every value under "limits" in server/metadata/app_defaults.json can be overridden by LIMITS_<PATH>, the path in
# uppercase joined by _ (number lists comma separated). Examples:
# LIMITS_JOBS_QUEUE_MAX_DEPTH=100
# LIMITS_JOBS_QUEUE_CONCURRENT_WORKERS=2
# LIMITS_AUTOMATION_MAX_EMAILS_PER_FETCH=50
# LIMITS_LLM_MAX_PROMPT_CHARS=4000
# LIMITS_LLM_MAX_INPUT_CHARS=15000
# LIMITS_LLM_TIMEOUT_MS=30000
# LIMITS_LLM_MAX_RETRIES=1
# LIMITS_LLM_MAX_CONCURRENCY=1
# LIMITS_TTS_MAX_CHARS=1500
# LIMITS_TTS_TIMEOUT_MS=300000
# LIMITS_NOTIFICATIONS_APPRISE_TIMEOUT_MS=60000
# LIMITS_NOTIFICATIONS_RETRY_DELAYS_MS=2000,8000,20000
# LIMITS_IMAP_CONNECTION_TIMEOUT_MS=10000
# LIMITS_IMAP_GREETING_TIMEOUT_MS=20000
# LIMITS_IMAP_MAX_EMAIL_MB=10
# Email attachments: off by default; when on, each source still has to opt in (its "Download attachments" setting).
# Allowed types are checked on the content, not on what the sender claims. Never add image/svg+xml.
# LIMITS_ATTACHMENTS_ENABLED=false
# LIMITS_ATTACHMENTS_MAX_MB=10
# LIMITS_ATTACHMENTS_MAX_PER_EMAIL=20
# LIMITS_ATTACHMENTS_TYPES=application/pdf,image/png,image/jpeg,image/gif,image/webp,text/csv
# Storage quota per user over all stored files (attachments, artifacts)
# LIMITS_FILES_MAX_USER_MB=1024
# LIMITS_SOURCES_DEFAULT_POLL_SECONDS=3600
# LIMITS_SOURCES_MIN_POLL_SECONDS=60
# LIMITS_SOURCES_MAX_POLL_SECONDS=604800
# LIMITS_SOURCES_PRUNE_EVERY_HOURS=24
# LIMITS_SOURCES_NEW_SEARCH_SINCE_DAYS=7
# LIMITS_USER_EVENTS_RETENTION_DAYS=30
# LIMITS_ACCOUNTS_MAX_API_TOKENS=20
# Largest request body in MB (larger ones get 413); raise it for big email imports
# LIMITS_HTTP_MAX_BODY_MB=5

# --- Storage and logging ----------------------------------------------------
# Pruning: every source deletes what it downloaded beyond its own limits (set per source). These cap them;
# 0 (default) = no cap, a source may set any value. Staged emails are kept.
# SOURCE_RETENTION_DAYS=0
# SOURCE_MAX_ITEMS=0
# SOURCE_MAX_SIZE_MB=0
# Data dir (database, migrations copy). Default: ./.data
# APP_DATA_DIR=/data
# Database URL, read at runtime. Default: file:<APP_DATA_DIR>/db/sqlite.db (the Docker image sets it)
# LIBSQL_URL=file:/app/.data/db/sqlite.db
# Where stored files (artifacts, attachments) are kept. Default: <APP_DATA_DIR>/files
# FILES_DIR=/data/files
# Old artifacts folder: imported into the file store once at startup (then marked with a .imported file). Default: ./Artifacts
# LOCAL_ARTIFACTS_DIR=/data/artifacts
# Check rows read from the database against their schema too (development; writes are always checked). Default: false
# DB_VALIDATE_READS=false
# error | warn | info | debug | none
# LOG_LEVEL_SYSTEM=error
# LOG_LEVEL_USER=none
# Log every request URL (true/false). Default: true
# LOG_REQUESTS=true

# Secrets for the test suite. Copy to tests/.env and fill in (tests/.env is not committed).
# On GitHub these come from repository secrets instead.

# Test server (own throwaway database): admin account and keys. Any random values work.
ADMIN_USER=admin
# 12-128 characters
ADMIN_PASSWORD=
SECRET_ENCRYPTION_KEY=
# at least 32 characters
NUXT_SESSION_PASSWORD=
# API token of the test admin: tbx_ + 43 base64url characters (any value of that form). global_setup stores its hash
# for the admin in the test database; the slow tests authenticate with it (Authorization: Bearer).
TEST_API_TOKEN=

# Real IMAP mailbox (tests/local only, not used by fast/slow); host and port are in tests/fixtures/sources.json
TEST_IMAP_USER=
TEST_IMAP_PASSWORD=

# ntfy topic of the Apprise test channel in tests/fixtures/channels.json
TEST_NTFY_TOPIC=
